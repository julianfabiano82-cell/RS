# RS backend — copiar a .env (o exportar) y completar. NUNCA subir valores reales al repo.
# Generar SECRET_KEY:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Generar FERNET_KEY:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ¡OJO! Si cambiás FERNET_KEY, las notas/zona cifradas con la clave anterior quedan ilegibles.
FERNET_KEY=
# Ruta del SQLite (opcional; por defecto backend/data.db)
# DATABASE_PATH=backend/data.db
# Poner RS_DEV=1 SOLO en desarrollo local (permite cookie sin HTTPS). En producción: 0 o sin definir.
# RS_DEV=0
# Ruta del index.html del Demand Board (default: <staging>/index.html — NO editar ese archivo)
# BOARD_PATH=/srv/rs/index.html
# Ruta del zones.json diario que genera el agente (default: <staging>/data/zones.json)
# ZONES_PATH=/srv/rs/data/zones.json
